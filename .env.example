PORT=3000
# Copy Neon pooled connection string here locally; never commit .env.
# Keep sslmode=verify-full (or Neon's supplied secure TLS options).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=verify-full
# Browser login; required on Vercel and in production. Use a strong unique password.
APP_USERNAME=admin
APP_PASSWORD=
